{
  "ConnectionStrings": {
    "SqlServer": "Server=localhost,1433;Database=LifeFitAI;User Id=sa;Password=<database-password>;TrustServerCertificate=True;Encrypt=False"
  },
  "Jwt": {
    "SigningKey": "<jwt-signing-key-at-least-32-bytes>",
    "Issuer": "LifeFitAI",
    "Audience": "LifeFitAI",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "PasswordResetMinutes": 30
  },
  "Gym": {
    "QrTokenMinutes": 10
  },
  "Ai": {
    "Provider": "Groq",
    "Model": "openai/gpt-oss-120b",
    "BaseUrl": "https://api.groq.com/openai/v1",
    "ApiKey": "<ai-api-key>",
    "TimeoutSeconds": 20,
    "MaxTokens": 800,
    "MaxPromptCharacters": 4000,
    "DailyRequestLimit": 20,
    "MonthlyRequestLimit": 200,
    "TenantDailyRequestLimit": 200,
    "TenantMonthlyRequestLimit": 2000,
    "CostPerThousandTokens": 0
  },
  "Password": {
    "Iterations": 210000,
    "SaltSize": 16,
    "HashSize": 32,
    "MinimumLength": 12,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireDigit": true,
    "RequireSpecial": true
  },
  "Security": {
    "AllowedOrigins": [ "https://app.example.com" ],
    "MaintenanceMode": false,
    "MaxRequestBytes": 1048576,
    "CommandTimeoutSeconds": 30
  },
  "RateLimit": {
    "GlobalPermitLimit": 300,
    "GlobalWindowSeconds": 60,
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60,
    "AiPermitLimit": 20,
    "AiWindowSeconds": 60,
    "CheckInPermitLimit": 30,
    "CheckInWindowSeconds": 60
  },
  "Redis": {
    "Enabled": false,
    "ConnectionString": "<redis-connection-string>"
  },
  "Storage": {
    "Provider": "Local",
    "RootPath": "storage"
  },
  "Email": {
    "Host": "<smtp-host>",
    "Port": 587,
    "Username": "<smtp-username>",
    "Password": "<smtp-password>",
    "FromAddress": "noreply@example.com"
  },
  "Observability": {
    "Enabled": true,
    "OtlpEndpoint": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
