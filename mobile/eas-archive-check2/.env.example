# Development (Expo Go / local API). Localhost is rewritten to the machine serving the Metro bundle.
EXPO_PUBLIC_API_URL=http://localhost:8080

# Android emulator reaching an API on the host machine:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# Production / EAS preview and production profiles set this automatically to:
# EXPO_PUBLIC_API_URL=https://api.growventur.com
#
# Staging URL is not configured in-repo. If you have a staging API, set it in the
# EAS "preview" profile env or a local .env — never commit secrets.
